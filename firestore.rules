      allow create, update: if canWriteOosQa();
      allow delete: if isSuperAdmin();
    }

    match /oos_approval_history/{docId} {
      allow read: if canReadOosModule();
      allow create: if canWriteOosQa();
      allow update, delete: if false;
    }

    match /oos_closure/{docId} {
      allow read: if canReadOosModule();
