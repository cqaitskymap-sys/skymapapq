      allow create, update, delete: if false;
    }

    match /product_attachments/{docId} {
      allow read: if isActiveUser() && canReadCollection('product_attachments');
      allow create, update, delete: if false;
    }

    match /batches/{docId} {
      allow read: if isActiveUser() && canReadCollection('batches');
      allow create, update, delete: if false;
    }

    match /batch_attachments/{docId} {
      allow read: if isActiveUser() && canReadCollection('batch_attachments');
      allow create, update, delete: if false;
    }

    match /parameters/{docId} {
      allow read: if isActiveUser() && canReadCollection('parameters');
      allow create, update, delete: if false;
    }

    match /workflows/{docId} {
      allow read: if isActiveUser() && canReadCollection('workflows');
      allow create, update, delete: if false;
    }

    match /workflow_steps/{docId} {
      allow read: if isActiveUser() && canReadCollection('workflow_steps');
      allow create, update, delete: if false;
    }

    match /approval_matrix/{docId} {
      allow read: if isActiveUser() && canReadCollection('approval_matrix');
      allow create, update, delete: if false;
    }

    match /document_numbering/{docId} {
      allow read: if isActiveUser() && canReadCollection('document_numbering');
      // Privileged document numbering writes are enforced by trusted Cloud Functions.
      allow create, update, delete: if false;
    }

    match /document_numbering_sequences/{docId} {
      allow read: if isActiveUser() && canReadCollection('document_numbering');
      // Atomic sequence increments are enforced by trusted Cloud Functions.
      allow create, update, delete: if false;
    }

    match /document_number_sequences/{docId} {
      allow read: if isActiveUser() && canReadCollection('document_numbering');
      // Legacy sequence collection — writes locked; Cloud Functions dual-write only.
      allow create, update, delete: if false;
    }

    // ── Document Acknowledgements (employees may update own records) ──
    match /document_acknowledgements/{docId} {
      allow read: if isActiveUser() && canReadCollection('document_acknowledgements');
      allow create: if isNotReadOnly() && canWriteCollection('document_acknowledgements');
      allow update: if isAuthenticated() && isNotReadOnly() && (
        canWriteCollection('document_acknowledgements')
        || (
          resource.data.employee_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'viewed_date', 'read_confirmation_date', 'acknowledgement_status',
            'comments', 'ip_address', 'device_information', 'browser_information',
            'updated_at', 'updated_by', 'updated_by_name'
          ])
          && request.resource.data.updated_by == request.auth.uid
        )
      );
      allow delete: if isSuperAdmin();
    }

    match /read_confirmations/{docId} {
      allow read: if isActiveUser() && canReadCollection('read_confirmations');
      allow create: if isAuthenticated() && isNotReadOnly()
        && request.resource.data.employee_id == request.auth.uid
        && request.resource.data.get('comments', '') is string
        && request.resource.data.get('comments', '').size() <= 4000;
      allow update, delete: if false;
    }

    match /document_reviews/{docId} {
      allow read: if isActiveUser() && canReadCollection('document_reviews');
      allow create: if isNotReadOnly() && canWriteCollection('document_reviews');
      allow update: if isAuthenticated() && isNotReadOnly() && (
        canWriteCollection('document_reviews')
        || resource.data.reviewer_id == request.auth.uid
      );
      allow delete: if isSuperAdmin();
    }

    match /review_comments/{docId} {
      allow read: if isActiveUser() && canReadCollection('review_comments');
      allow create: if isAuthenticated() && isNotReadOnly();
      allow update, delete: if isSuperAdmin();
    }

    match /document_approvals/{docId} {
      allow read: if isActiveUser() && canReadCollection('document_approvals');
      allow create: if isNotReadOnly() && canWriteCollection('document_approvals');
      allow update: if isAuthenticated() && isNotReadOnly() && (
        canWriteCollection('document_approvals')
        || resource.data.approver_id == request.auth.uid
        || resource.data.delegated_to == request.auth.uid
      );
      allow delete: if isSuperAdmin();
    }

    match /approval_comments/{docId} {
      allow read: if isActiveUser() && canReadCollection('approval_comments');
      allow create: if isAuthenticated() && isNotReadOnly();
      allow update, delete: if isSuperAdmin();
    }

    match /approval_delegations/{docId} {
      allow read: if isActiveUser() && canReadCollection('approval_delegations');
      allow create: if isNotReadOnly() && canWriteCollection('approval_delegations');
      allow update, delete: if isSuperAdmin();
    }

    // ── Default: registered collections ──
    match /{collection}/{docId} {
      allow read: if isActiveUser()
        && isRegisteredCollection(collection)
        && canReadCollection(collection)
        && (
          getProfileRole() != 'vendor'
          || resource.data.get('userId', '') == request.auth.uid
          || resource.data.get('vendorUserId', '') == request.auth.uid
        )
;
      // Explicit CF-locked collections are denied here so catch-all OR semantics
      // cannot reopen client writes when a dedicated match also exists.
      allow create: if isActiveUser() && isNotReadOnly()
        && isRegisteredCollection(collection)
        && canWriteCollection(collection)
        && !isAuditCollection(collection)
        && !isServerOwnedCollection(collection)
        && !(collection in [
          'products', 'cpv_products', 'cpv_batches', 'batches',
          'cpp_results', 'cpv_cpp', 'cqa_results', 'cpv_cqa',
          'raw_material_monitoring', 'cpv_raw_materials',
          'packing_material_monitoring', 'cpv_packing_materials',
          'utility_monitoring', 'cpv_utility_monitoring', 'cpv_utility',
          'environmental_monitoring', 'cpv_environment_monitoring',
          'yield_monitoring', 'cpv_yield_monitoring', 'cpv_yield',
          'hold_time_monitoring', 'hold_time_master', 'cpv_hold_time',
          'process_capability', 'cpv_capability',
          'trend_analysis', 'cpv_trends',
          'control_charts', 'spc_rule_violations', 'cpv_control_charts',
          'risk_assessment', 'risk_assessments', 'risk_controls', 'risk_reviews', 'cpv_risk_assessment',
          'cpv_reviews', 'cpv_review_sections', 'cpv_review_approvals', 'cpv_annual_review',
          'reports', 'report_exports',
          'alerts', 'alert_rules', 'alert_notifications', 'alert_escalations',
          'cpv_configuration', 'cpv_config_products', 'cpv_limit_rules', 'cpv_review_frequency',
          'cpv_alert_rules', 'cpv_report_templates', 'cpv_workflows', 'cpv_integration_mapping',
          'stability_studies', 'stability_schedules', 'stability_results',
          'stability_monitoring', 'cpv_stability_studies',
          'product_compositions', 'product_packing_details', 'product_attachments',
          'batch_attachments', 'parameters'
        ]);
      allow update: if isActiveUser() && isNotReadOnly()
        && isRegisteredCollection(collection)
        && canWriteCollection(collection)
        && !isAuditCollection(collection)
        && !isServerOwnedCollection(collection)
        && qmsClosedUpdateAllowed(collection)
        && !(collection in [
          'products', 'cpv_products', 'cpv_batches', 'batches',
          'cpp_results', 'cpv_cpp', 'cqa_results', 'cpv_cqa',
          'raw_material_monitoring', 'cpv_raw_materials',
          'packing_material_monitoring', 'cpv_packing_materials',
          'utility_monitoring', 'cpv_utility_monitoring', 'cpv_utility',
          'environmental_monitoring', 'cpv_environment_monitoring',
          'yield_monitoring', 'cpv_yield_monitoring', 'cpv_yield',
          'hold_time_monitoring', 'hold_time_master', 'cpv_hold_time',
          'process_capability', 'cpv_capability',
          'trend_analysis', 'cpv_trends',
          'control_charts', 'spc_rule_violations', 'cpv_control_charts',
          'risk_assessment', 'risk_assessments', 'risk_controls', 'risk_reviews', 'cpv_risk_assessment',
          'cpv_reviews', 'cpv_review_sections', 'cpv_review_approvals', 'cpv_annual_review',
          'reports', 'report_exports',
          'alerts', 'alert_rules', 'alert_notifications', 'alert_escalations',
          'cpv_configuration', 'cpv_config_products', 'cpv_limit_rules', 'cpv_review_frequency',
          'cpv_alert_rules', 'cpv_report_templates', 'cpv_workflows', 'cpv_integration_mapping',
          'stability_studies', 'stability_schedules', 'stability_results',
          'stability_monitoring', 'cpv_stability_studies',
          'product_compositions', 'product_packing_details', 'product_attachments',
          'batch_attachments', 'parameters'
        ]);
      allow delete: if isSuperAdmin()
        && isRegisteredCollection(collection)
        && !isAuditCollection(collection)
        && !isServerOwnedCollection(collection)
        && !(collection in [
          'products', 'cpv_products', 'cpv_batches', 'batches',
          'cpp_results', 'cpv_cpp', 'cqa_results', 'cpv_cqa',
          'raw_material_monitoring', 'cpv_raw_materials',
          'packing_material_monitoring', 'cpv_packing_materials',
          'utility_monitoring', 'cpv_utility_monitoring', 'cpv_utility',
          'environmental_monitoring', 'cpv_environment_monitoring',
          'yield_monitoring', 'cpv_yield_monitoring', 'cpv_yield',
          'hold_time_monitoring', 'hold_time_master', 'cpv_hold_time',
          'process_capability', 'cpv_capability',
          'trend_analysis', 'cpv_trends',
          'control_charts', 'spc_rule_violations', 'cpv_control_charts',
          'risk_assessment', 'risk_assessments', 'risk_controls', 'risk_reviews', 'cpv_risk_assessment',
          'cpv_reviews', 'cpv_review_sections', 'cpv_review_approvals', 'cpv_annual_review',
          'reports', 'report_exports',
          'alerts', 'alert_rules', 'alert_notifications', 'alert_escalations',
          'cpv_configuration', 'cpv_config_products', 'cpv_limit_rules', 'cpv_review_frequency',
          'cpv_alert_rules', 'cpv_report_templates', 'cpv_workflows', 'cpv_integration_mapping',
          'stability_studies', 'stability_schedules', 'stability_results',
          'stability_monitoring', 'cpv_stability_studies',
          'product_compositions', 'product_packing_details', 'product_attachments',
          'batch_attachments', 'parameters'
        ]);
    }
  }
}
