rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    function profileData() {
      return get(profilePath()).data;
    }

    // Missing access_status must not block active users (many legacy profiles omit it).
    function isAuthenticated() {
      return request.auth != null
        && exists(profilePath())
        && profileData().is_active == true
        && profileData().get('access_status', 'approved') != 'pending';
    }

    function isActiveUser() {
      return isAuthenticated();
    }

    function getProfileRole() {
      return profileData().role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getProfileRole() == 'super_admin';
    }

    function isAdmin() {
      return isAuthenticated() && getProfileRole() in ['super_admin', 'admin'];
    }

    function canReadAdminDirectory() {
      return isAuthenticated() && getProfileRole() in [
        'super_admin', 'admin', 'head_qa', 'auditor'
      ];
    }

    function canReadProfileDirectory() {
      return isAuthenticated() && getProfileRole() in [
        'super_admin', 'admin', 'head_qa', 'auditor', 'hr'
      ];
    }

    function isReadOnly() {
      return isAuthenticated() && getProfileRole() in ['auditor', 'vendor', 'viewer'];
    }

    function isNotReadOnly() {
      return isAuthenticated() && !isReadOnly();
    }

    function isQaRole() {
      return getProfileRole() in [
        'super_admin', 'admin', 'head_qa', 'qa_manager', 'qa_executive', 'qa'
      ];
    }

    function isQcRole() {
      return getProfileRole() in ['super_admin', 'admin', 'qc_manager', 'qc_executive', 'qc'];
    }

    function isProductionRole() {
      return getProfileRole() in ['super_admin', 'admin', 'production_manager', 'production_executive', 'production'];
    }

    function isEngineeringRole() {
      return getProfileRole() in [
        'super_admin', 'admin', 'engineering_manager', 'engineering_executive',
        'engineering', 'maintenance'
      ];
    }

    // Equipment Management module collections (QMS + Admin master).
    function isEquipmentCollection(name) {
      return name in [
        'equipment_master', 'equipment_records', 'calibration_records',
        'pm_records', 'breakdown_records', 'equipment_status_history',
        'equipment_attachments'
      ];
    }

    function canManageEquipmentData() {
      return isAuthenticated() && getProfileRole() in [
        'super_admin', 'admin', 'head_qa', 'qa_manager',
        'engineering_manager', 'engineering_executive', 'engineering', 'maintenance'
      ];
    }

    // QMS Environmental & Utility Monitoring (client-side module; distinct from CPV *_monitoring).
    function isMonitoringCollection(name) {
      return name in [
        'monitoring_area_master', 'monitoring_environmental', 'monitoring_utility',
        'monitoring_excursions', 'monitoring_trends', 'monitoring_attachments'
      ];
    }

    function canManageMonitoringData() {
      return isAuthenticated() && getProfileRole() in [
        'super_admin', 'admin', 'head_qa', 'qa_manager',
        'engineering', 'maintenance', 'qc_manager', 'production_manager'
      ];
    }

    function isWarehouseRole() {
      return getProfileRole() in ['super_admin', 'admin', 'warehouse_manager', 'warehouse_executive', 'warehouse'];
    }

    // QMS Warehouse Traceability module collections.
    function isWarehouseMgmtCollection(name) {
      return name in [
        'material_receipts', 'qc_sampling', 'material_release', 'material_dispensing',
        'inventory_stock', 'finished_goods', 'material_traceability', 'warehouse_attachments'
      ];
    }

    function canManageWarehouseData() {
      return isAuthenticated() && getProfileRole() in [
        'super_admin', 'admin', 'head_qa', 'qa_manager',
        'warehouse_manager', 'warehouse_executive', 'warehouse',
        'qc_manager', 'production_manager'
      ];
    }

    function isEbmrCollection(name) {
      return name.matches('ebmr_.*');
    }

    function canManageEbmrData() {
      return isAuthenticated() && getProfileRole() in [
        'super_admin', 'admin', 'head_qa', 'qa_manager', 'qa_executive', 'qa',
        'qc_manager', 'qc_executive', 'qc',
        'production_manager', 'production_executive', 'production',
        'warehouse_manager', 'warehouse_executive', 'warehouse',
        'engineering_manager', 'engineering_executive', 'engineering'
      ];
    }

    function isRegulatoryRole() {
      return getProfileRole() in ['super_admin', 'admin', 'regulatory_affairs', 'regulatory'];
    }

    function canReadAuditTrail() {
      return isActiveUser() && getProfileRole() in [
        'super_admin', 'admin', 'head_qa', 'qa_manager', 'qa_executive', 'qa',
        'regulatory_affairs', 'regulatory', 'auditor'
      ];
    }

    function isAuditCollection(name) {
      return name.matches('.*audit_trail.*')
        || name.matches('.*audit_logs.*')
        || name in ['cpv_audit_trail', 'audit_logs', 'audit_trail', 'packaging_audit_trail', 'audit_logs_material', 'integration_logs'];
    }

    // Dedicated matches lock these to Cloud Functions. Catch-all OR must not reopen them.
    function isServerOwnedCollection(name) {
      return name in [
        'users', 'roles', 'permissions', 'user_permissions',
        'login_activity', 'login_activity_archive',
        'access_reviews', 'access_reviews_archive',
        'system_settings', 'system_settings_versions',
        'esign_settings', 'notification_settings', 'email_sms_templates',
        'module_configuration', 'master_data_import_export', 'master_data_import_export_errors',
        'backup_history', 'backup_restore', 'backup_settings', 'restore_history', 'backup_jobs',
        'backup_history_archive', 'restore_history_archive',
        'departments', 'designations', 'company_sites',
        'workflows', 'workflow_steps', 'approval_matrix',
        'document_numbering', 'document_numbering_sequences', 'document_number_sequences',
        'password_policy', 'notification_templates', 'system_logs'
      ];
    }

    // Non-prefixed CPV collections (legacy cpv_* covered by name.matches('cpv_.*')).
    function isCpvOperationalCollection(name) {
      return name.matches('cpv_.*')
        || name in [
          'cpp_parameters', 'cpp_results', 'cqa_parameters', 'cqa_results',
          'area_master',
          'utility_master',
          'hold_time_master',
          'risk_register',
          'ai_predictions', 'ai_recommendations'
        ];
    }

    // PQR module collections (pqr_* plus equipment/vendor sources used by PQR reviews).
    function isPqrOperationalCollection(name) {
      return name.matches('pqr_.*')
        || name in [
          'material_review', 'approved_vendor_list', 'packing_material_master',
          'equipment_qualification', 'equipment_calibration',
          'preventive_maintenance', 'pm_records', 'breakdown_records',
          'equipment_usage_logs', 'utility_equipment'
        ];
    }

    function isRegisteredCollection(name) {
      return isCpvOperationalCollection(name)
        || isPqrOperationalCollection(name)
        || isEbmrCollection(name)
        || name in [
          'users', 'roles', 'permissions', 'user_permissions', 'products', 'batches',
          'cpv_reviews', 'cpp_parameters', 'cpp_results',
          'cqa_parameters', 'cqa_results', 'risk_assessment',
          'hold_time_monitoring', 'cpv_hold_time',
          'process_capability', 'cpv_capability',
          'trend_analysis', 'cpv_trends',
          'control_charts', 'spc_rule_violations', 'cpv_control_charts',
          'risk_assessment', 'risk_assessments', 'risk_controls', 'risk_reviews', 'cpv_risk_assessment',
          'reports', 'report_exports',
          'alerts', 'alert_rules', 'alert_notifications', 'alert_escalations',
          'cpv_configuration', 'cpv_config_products', 'cpv_limit_rules', 'cpv_review_frequency',
          'cpv_alert_rules', 'cpv_report_templates', 'cpv_workflows', 'cpv_integration_mapping',
          'pqr_records', 'pqr_documents', 'pqr_batches',
          'deviations', 'oos_records', 'oos',
          'oos_phase1', 'oos_phase2', 'oos_impact_assessment', 'oos_capa_link',
          'oos_approvals', 'oos_approval_history', 'oos_closure',
          'oos_trends', 'oos_reports', 'oos_attachments',
          'capa_records', 'capa', 'capa_reports', 'capa_trends',
          'change_controls', 'change_control', 'change_implementation_plans', 'change_implementation_tasks', 'change_implementation_actions',
          'change_risk_assessments',
          'change_impact_assessments',
          'change_reports',
          'stability_studies', 'stability',
          'complaints', 'complaint_reports', 'recalls', 'recall_records', 'recall_reports', 'recall_distribution',
          'recall_recovery', 'recall_regulatory_notifications', 'recall_closure', 'recall_trends',
          'recall_approvals', 'recall_attachments', 'customers',
          'deviation_reports',
          'risk_reports', 'audit_reports', 'validation_reports',
          'documents', 'dms_documents',
          'document_revisions', 'document_versions', 'document_approvals',
          'document_distribution', 'distribution_lists', 'distribution_groups',
          'document_acknowledgements', 'read_confirmations',
          'document_attachments', 'document_lifecycle',
          'document_reviews', 'review_workflows', 'review_steps', 'review_comments', 'review_checklists',
          'approval_delegations', 'approval_escalations', 'approval_comments', 'electronic_signatures',
          'signature_meanings', 'signature_sessions', 'signature_settings',
          'document_effective_dates', 'document_archives', 'document_archive',
          'archive_jobs', 'archive_policies', 'archive_requests', 'archive_restoration_requests', 'archive_locations', 'retention_policies',
          'retention_schedules', 'retention_reviews', 'retention_events', 'disposal_requests', 'disposal_approvals', 'disposal_certificates', 'legal_holds', 'regulatory_holds',
          'external_documents', 'external_document_versions', 'external_document_reviews', 'external_document_distribution', 'external_document_sources', 'external_document_categories',
          'supplier_documents', 'regulatory_documents', 'standards_documents', 'safety_documents', 'linked_internal_documents',
          'print_requests', 'printed_documents', 'print_copies', 'print_locations', 'print_distribution', 'print_reconciliation', 'print_returns', 'print_destruction',
          'watermark_templates', 'watermark_rules', 'watermark_history', 'document_watermarks',
          'audit_events', 'audit_exports', 'audit_filters',
          'periodic_reviews', 'review_schedules', 'review_decisions',
          'document_obsolete',
          'sop_master', 'sop_versions', 'sop_reviews', 'sop_approvals',
          'sop_training_links', 'sop_distribution', 'sop_acknowledgements',
          'sop_periodic_reviews', 'sop_archive',
          'work_instructions', 'wi_versions', 'wi_reviews', 'wi_approvals',
          'wi_training_links', 'wi_distribution', 'wi_acknowledgements',
          'wi_periodic_reviews', 'wi_archive',
          'forms_templates', 'form_versions', 'form_reviews', 'form_approvals',
          'form_distribution', 'form_acknowledgements', 'form_periodic_reviews',
          'form_archive', 'production_lines', 'sop_management',
          'approval_workflows', 'approval_requests', 'approval_steps', 'approval_requests_history',
          'integration_logs', 'integration_settings',
          'audits', 'audit_mgmt_records',
          'vendors', 'vendor_master', 'vendor_records',
          'approved_vendor_list', 'vendor_qualifications', 'supplier_audits',
          'technical_agreements', 'vendor_performance', 'vendor_attachments',
          'vendor_reviews',
          'validation_records', 'csv_systems',
          'equipment_master', 'equipment_records', 'calibration_records',
          'pm_records', 'breakdown_records', 'equipment_status_history',
          'equipment_attachments',
          'monitoring_area_master', 'monitoring_environmental', 'monitoring_utility',
          'monitoring_excursions', 'monitoring_trends', 'monitoring_attachments',
          'material_receipts', 'qc_sampling', 'material_release', 'material_dispensing',
          'inventory_stock', 'finished_goods', 'material_traceability', 'warehouse_attachments',
          'monitoring_records', 'warehouse_materials', 'warehouse_records',
          'ebmr_records', 'notifications',
          'material_master', 'packaging_material_master',
          'departments', 'designations', 'company_sites', 'parameters',
          'workflows', 'approval_matrix', 'document_numbering',
          'notification_settings', 'esign_settings', 'system_settings', 'backup_history',
          'backup_restore', 'backup_settings', 'restore_history', 'backup_jobs',
          'backup_history_archive', 'restore_history_archive',
          'notification_templates', 'system_logs', 'login_activity', 'access_reviews',
          'password_policy', 'module_configuration', 'email_sms_templates',
          'master_data_import_export', 'master_data_import_export_errors',
          'product_compositions', 'product_packing_details',
          'product_attachments', 'batch_attachments', 'workflow_steps',
          'document_number_sequences', 'document_numbering_sequences'
        ];
    }

    function isDocumentCollection(name) {
      return name.matches('.*document.*')
        || name.matches('sop_.*')
        || name.matches('wi_.*')
        || name.matches('form_.*')
        || name in [
          'work_instructions', 'forms_templates', 'periodic_reviews',
          'review_comments', 'approval_comments', 'approval_delegations',
          'read_confirmations', 'sop_management'
        ];
    }

    function canReadCollection(name) {
      return getProfileRole() in [
          'super_admin', 'admin', 'head_qa', 'qa_manager', 'qa_executive', 'qa',
          'qc_manager', 'qc_executive', 'qc', 'production_manager',
          'production_executive', 'production', 'engineering_manager',
          'engineering_executive', 'engineering', 'maintenance', 'warehouse_manager',
          'warehouse_executive', 'warehouse', 'regulatory_affairs', 'regulatory',
          'auditor', 'viewer', 'it_administrator'
        ]
        || (getProfileRole() == 'hr' && isDocumentCollection(name))
        || (getProfileRole() == 'document_controller' && isDocumentCollection(name))
        || (getProfileRole() == 'department_head'
          && (isDocumentCollection(name)
            || name in [
              'deviations', 'capa', 'capa_records',
              'oos_records', 'oos', 'oos_phase1', 'oos_phase2', 'oos_impact_assessment',
              'oos_capa_link', 'oos_approvals', 'oos_approval_history', 'oos_closure'
            ]))
        || (getProfileRole() == 'employee' && isDocumentCollection(name))
        || (getProfileRole() == 'vendor'
          && name in ['vendors', 'vendor_master', 'vendor_records']);
    }

    function canWriteCollection(name) {
      return isSuperAdmin()
        || (isQaRole() && name in ['pqr_records', 'pqr_documents', 'deviations', 'deviation_reports', 'oos_records', 'oos', 'oos_phase1', 'oos_phase2', 'oos_impact_assessment', 'oos_capa_link', 'oos_approvals', 'oos_approval_history', 'oos_closure', 'oos_trends', 'oos_reports', 'oos_attachments', 'capa_records', 'capa', 'capa_reports', 'capa_trends', 'change_controls', 'change_control', 'change_implementation_plans', 'change_implementation_tasks', 'change_implementation_actions', 'change_risk_assessments', 'change_impact_assessments', 'change_reports', 'complaints', 'complaint_reports', 'recalls', 'recall_records', 'recall_reports', 'recall_distribution', 'recall_recovery', 'recall_regulatory_notifications', 'recall_closure', 'recall_trends', 'recall_approvals', 'recall_attachments', 'risk_reports', 'audit_reports', 'validation_reports', 'validation_records', 'audits', 'audit_mgmt_records', 'stability_studies', 'approval_workflows', 'approval_requests', 'approval_steps', 'approval_requests_history', 'approval_delegations', 'approval_escalations', 'approval_comments', 'electronic_signatures', 'signature_meanings', 'signature_sessions', 'signature_settings', 'documents', 'dms_documents', 'document_revisions', 'document_versions', 'document_approvals', 'document_distribution', 'distribution_lists', 'distribution_groups', 'document_acknowledgements', 'read_confirmations', 'document_attachments', 'document_lifecycle', 'document_reviews', 'review_workflows', 'review_steps', 'review_comments', 'review_checklists', 'document_effective_dates', 'periodic_reviews', 'review_schedules', 'review_decisions', 'document_archives', 'document_archive', 'archive_jobs', 'archive_policies', 'archive_requests', 'archive_restoration_requests', 'archive_locations', 'retention_policies', 'retention_schedules', 'retention_reviews', 'retention_events', 'disposal_requests', 'disposal_approvals', 'disposal_certificates', 'legal_holds', 'regulatory_holds', 'external_documents', 'external_document_versions', 'external_document_reviews', 'external_document_distribution', 'external_document_sources', 'external_document_categories', 'supplier_documents', 'regulatory_documents', 'standards_documents', 'safety_documents', 'linked_internal_documents', 'print_requests', 'printed_documents', 'print_copies', 'print_locations', 'print_distribution', 'print_reconciliation', 'print_returns', 'print_destruction', 'watermark_templates', 'watermark_rules', 'watermark_history', 'document_watermarks', 'audit_events', 'audit_exports', 'audit_filters', 'document_obsolete', 'sop_master', 'sop_versions', 'sop_reviews', 'sop_approvals', 'sop_training_links', 'sop_distribution', 'sop_acknowledgements', 'sop_periodic_reviews', 'sop_archive', 'sop_management', 'work_instructions', 'wi_versions', 'wi_reviews', 'wi_approvals', 'wi_training_links', 'wi_distribution', 'wi_acknowledgements', 'wi_periodic_reviews', 'wi_archive', 'forms_templates', 'form_versions', 'form_reviews', 'form_approvals', 'form_distribution', 'form_acknowledgements', 'form_periodic_reviews', 'form_archive', 'production_lines'])


        || (isQcRole() && name in [
          'oos_records', 'oos', 'oos_phase1', 'oos_phase2', 'oos_impact_assessment',
          'oos_capa_link', 'oos_approvals', 'oos_approval_history', 'oos_closure',
          'oos_trends', 'oos_reports', 'oos_attachments',
          'cqa_parameters', 'cqa_results', 'stability_studies', 'stability'
        ])
        || (isProductionRole() && name in [
          'batches', 'cpp_parameters', 'cpp_results', 'ebmr_records',
          'oos_phase2', 'oos_impact_assessment'
        ])
        || (canManageEbmrData() && isEbmrCollection(name))
        || (isEngineeringRole() && name in ['equipment_master', 'equipment_records', 'calibration_records', 'validation_records', 'csv_systems', 'monitoring_records'])
        || (canManageEquipmentData() && isEquipmentCollection(name))
        || (canManageMonitoringData() && isMonitoringCollection(name))
        || (canManageWarehouseData() && isWarehouseMgmtCollection(name))
        || (isWarehouseRole() && name in ['warehouse_materials', 'warehouse_records', 'material_master', 'recall_distribution', 'recall_recovery'])
        || (isRegulatoryRole() && name in ['change_controls', 'change_control', 'recalls', 'recall_records', 'recall_regulatory_notifications', 'documents', 'dms_documents', 'document_revisions', 'document_versions', 'document_approvals', 'document_distribution', 'distribution_lists', 'distribution_groups', 'document_acknowledgements', 'read_confirmations', 'document_attachments', 'document_lifecycle', 'document_reviews', 'review_workflows', 'review_steps', 'review_comments', 'review_checklists', 'approval_delegations', 'approval_escalations', 'approval_comments', 'electronic_signatures', 'document_effective_dates', 'periodic_reviews', 'review_schedules', 'review_decisions', 'document_archives', 'document_archive', 'archive_jobs', 'archive_policies', 'archive_requests', 'archive_restoration_requests', 'archive_locations', 'retention_policies', 'retention_schedules', 'retention_reviews', 'retention_events', 'disposal_requests', 'disposal_approvals', 'disposal_certificates', 'legal_holds', 'regulatory_holds', 'external_documents', 'external_document_versions', 'external_document_reviews', 'external_document_distribution', 'external_document_sources', 'external_document_categories', 'supplier_documents', 'regulatory_documents', 'standards_documents', 'safety_documents', 'linked_internal_documents', 'print_requests', 'printed_documents', 'print_copies', 'print_locations', 'print_distribution', 'print_reconciliation', 'print_returns', 'print_destruction', 'watermark_templates', 'watermark_rules', 'watermark_history', 'document_watermarks', 'audit_events', 'audit_exports', 'audit_filters', 'document_obsolete', 'sop_master', 'sop_versions', 'sop_reviews', 'sop_approvals', 'sop_training_links', 'sop_distribution', 'sop_acknowledgements', 'sop_periodic_reviews', 'sop_archive', 'sop_management', 'work_instructions', 'wi_versions', 'wi_reviews', 'wi_approvals', 'wi_training_links', 'wi_distribution', 'wi_acknowledgements', 'wi_periodic_reviews', 'wi_archive', 'forms_templates', 'form_versions', 'form_reviews', 'form_approvals', 'form_distribution', 'form_acknowledgements', 'form_periodic_reviews', 'form_archive', 'production_lines', 'pqr_records'])
        || (isNotReadOnly() && isCpvOperationalCollection(name))
        || (isNotReadOnly() && isPqrOperationalCollection(name));
    }

    // ── Profiles & Users ──
    match /profiles/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || canReadProfileDirectory()
        || (isAuthenticated()
          && getProfileRole() == 'department_head'
          && resource.data.department
            == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.department)
      );
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'id', 'email', 'full_name', 'role', 'department', 'employee_id', 'phone',
          'avatar_url', 'is_active', 'last_login', 'created_at', 'updated_at',
          'requested_role', 'access_status'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.full_name is string
        && request.resource.data.full_name.size() <= 200
        && request.resource.data.id == userId
        && request.resource.data.role == 'viewer'
        && request.resource.data.requested_role in [
          'qa', 'qc', 'production', 'engineering', 'warehouse', 'regulatory',
          'hr', 'document_controller', 'department_head',
          'employee', 'auditor', 'vendor', 'viewer'
        ]
        && request.resource.data.is_active == false
        && request.resource.data.access_status == 'pending';
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'full_name', 'phone', 'avatar_url', 'updated_at', 'last_login'
          ])
          && request.resource.data.full_name is string
          && request.resource.data.full_name.size() <= 200
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 40
          && request.resource.data.avatar_url is string
          && request.resource.data.avatar_url.size() <= 2048)
      );
      allow delete: if isSuperAdmin();
    }

    match /users/{docId} {
      allow read: if canReadAdminDirectory();
      // Authentication accounts and directory records are created atomically by a trusted Cloud Function.
      allow create: if false;
      allow update, delete: if false;
    }

    match /roles/{docId} {
      allow read: if canReadAdminDirectory();
      // Privileged role writes are enforced by trusted Cloud Functions.
      allow create, update, delete: if false;
    }

    match /permissions/{docId} {
      allow read: if canReadAdminDirectory();
      // Privileged permission matrix writes are enforced by trusted Cloud Functions.
      allow create, update, delete: if false;
    }

    match /user_permissions/{docId} {
      allow read: if canReadAdminDirectory()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /login_activity/{sessionId} {
      allow read: if canReadAuditTrail()
        || (isActiveUser() && resource.data.userId == request.auth.uid);
      // Privileged login/session writes are enforced by trusted Cloud Functions.
      allow create, update, delete: if false;
    }

    match /login_activity_archive/{sessionId} {
      allow read: if canReadAuditTrail();
      allow create, update, delete: if false;
    }

    match /access_reviews/{reviewId} {
      allow read: if canReadAuditTrail() || canReadAdminDirectory();
      // Privileged access-review writes are enforced by trusted Cloud Functions.
      allow create, update, delete: if false;
    }

    match /access_reviews_archive/{reviewId} {
      allow read: if canReadAuditTrail();
      allow create, update, delete: if false;
    }

    // ── Immutable audit trail (writes via trusted Cloud Functions only) ──
    match /audit_trail/{logId} {
      allow read: if canReadAuditTrail();
      allow create, update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if canReadAuditTrail();
      allow create, update, delete: if false;
    }

    match /audit_events/{eventId} {
      allow read: if canReadAuditTrail();
      allow create, update, delete: if false;
    }

    match /audit_exports/{exportId} {
      allow read: if canReadAuditTrail();
      allow create, update, delete: if false;
    }

    match /audit_trail_archive/{logId} {
      allow read: if canReadAuditTrail();
      allow create, update, delete: if false;
    }

    match /esign_records/{recordId} {
      allow read: if canReadAuditTrail()
        || (isActiveUser() && (
          resource.data.get('user_id', '') == request.auth.uid
          || resource.data.get('userId', '') == request.auth.uid
          || resource.data.get('signed_by', '') == request.auth.uid
        ));
      allow create: if isActiveUser() && (
        request.resource.data.get('user_id', '') == request.auth.uid
        || request.resource.data.get('userId', '') == request.auth.uid
        || request.resource.data.get('signed_by', '') == request.auth.uid
      );
      allow update, delete: if false;
    }

    match /electronic_signatures/{recordId} {
      allow read: if canReadAuditTrail()
        || (isActiveUser() && (
          resource.data.get('user_id', '') == request.auth.uid
          || resource.data.get('userId', '') == request.auth.uid
          || resource.data.get('signed_by', '') == request.auth.uid
          || resource.data.get('signer_user_id', '') == request.auth.uid
        ));
      allow create: if isActiveUser() && isNotReadOnly() && (
        request.resource.data.get('user_id', '') == request.auth.uid
        || request.resource.data.get('userId', '') == request.auth.uid
        || request.resource.data.get('signed_by', '') == request.auth.uid
        || request.resource.data.get('signer_user_id', '') == request.auth.uid
      );
      allow update: if isActiveUser() && isQaRole()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verified_at', 'verified_by']);
      allow delete: if false;
    }

    match /signature_meanings/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isNotReadOnly() && (isSuperAdmin() || isQaRole());
      allow delete: if isSuperAdmin();
    }

    match /signature_sessions/{docId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && isNotReadOnly();
      allow update: if isActiveUser() && isNotReadOnly();
      allow delete: if false;
    }

    match /signature_settings/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isNotReadOnly() && (isSuperAdmin() || isAdmin() || isQaRole());
      allow delete: if isSuperAdmin();
    }

    match /cpv_audit_trail/{logId} {
      allow read: if canReadAuditTrail();
      allow create: if isNotReadOnly();
      allow update, delete: if false;
    }

    match /packaging_audit_trail/{logId} {
      allow read: if canReadAuditTrail();
      allow create: if isNotReadOnly();
      allow update, delete: if false;
    }

    match /audit_logs_material/{logId} {
      allow read: if canReadAuditTrail();
      allow create: if isNotReadOnly();
      allow update, delete: if false;
    }

    // ── OOS satellite collections ──
    // Dedicated matches avoid catch-all `resource.data` OR rejecting list queries.
    function canReadOosModule() {
      return isActiveUser() && (
        canReadCollection('oos_records')
        || isQaRole()
        || isQcRole()
        || isProductionRole()
        || getProfileRole() in ['it_administrator', 'department_head', 'head_qa']
      );
    }

    function canWriteOosQa() {
      return isActiveUser() && isNotReadOnly() && (
        isSuperAdmin()
        || isQaRole()
        || isQcRole()
      );
    }

    function canWriteOosInvestigation() {
      return canWriteOosQa() || (isActiveUser() && isNotReadOnly() && isProductionRole());
    }

    function fieldIsClosed(data, field) {
      return data.get(field, '') is string && data.get(field, '').lower() == 'closed';
    }

    function qmsSourceClosed() {
      return fieldIsClosed(resource.data, 'status')
        || fieldIsClosed(resource.data, 'capa_status')
        || fieldIsClosed(resource.data, 'recall_status');
    }

    function qmsControlledReopen() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'capa_status', 'recall_status', 'is_locked',
        'actual_closure_date', 'closure_date', 'qa_remarks',
        'updated_by', 'updated_by_name', 'updated_at'
      ])
      && (!fieldIsClosed(resource.data, 'status') || !fieldIsClosed(request.resource.data, 'status'))
      && (!fieldIsClosed(resource.data, 'capa_status') || !fieldIsClosed(request.resource.data, 'capa_status'))
      && (!fieldIsClosed(resource.data, 'recall_status') || !fieldIsClosed(request.resource.data, 'recall_status'));
    }

    function qmsLinkAnnotation() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'linked_capa_number', 'linked_capa_id', 'capa_required',
        'updated_by', 'updated_by_name', 'updated_at'
      ]);
    }

    function qmsClosedUpdateAllowed(name) {
      return !(name in [
        'deviations', 'capa_records', 'capa', 'change_controls', 'change_control',
        'oos_records', 'oos', 'complaints', 'recalls', 'recall_records'
      ]) || !qmsSourceClosed() || qmsControlledReopen() || qmsLinkAnnotation();
    }

    match /oos_phase1/{docId} {
      allow read: if canReadOosModule();
      allow create, update: if canWriteOosQa();
      allow delete: if isSuperAdmin();
    }

    match /oos_phase2/{docId} {
      allow read: if canReadOosModule();
      allow create, update: if canWriteOosInvestigation();
      allow delete: if isSuperAdmin();
    }

    match /oos_impact_assessment/{docId} {
      allow read: if canReadOosModule();
      allow create, update: if canWriteOosInvestigation();
      allow delete: if isSuperAdmin();
    }

    match /oos_capa_link/{docId} {
