      allow create, update: if canWriteOosQa();
      allow delete: if isSuperAdmin();
    }

    match /oos_attachments/{docId} {
      allow read: if canReadOosModule();
      allow create, update: if canWriteOosQa();
      allow delete: if isSuperAdmin();
    }

    // ── Notifications ──
    // Split get/list and use separate `allow list` statements so OR + resource.data
    // does not block admin list queries (Firestore rules are not filters).
    // Support both camelCase (new) and snake_case (legacy) notification fields.
    match /notifications/{docId} {
      allow get: if isActiveUser() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.user_id == request.auth.uid
        || resource.data.recipientRole == getProfileRole()
        || resource.data.target_role == getProfileRole()
      );
      allow list: if isActiveUser() && isAdmin();
      allow list: if isActiveUser() && resource.data.userId == request.auth.uid;
      allow list: if isActiveUser() && resource.data.user_id == request.auth.uid;
      allow list: if isActiveUser() && resource.data.recipientRole == getProfileRole();
      allow list: if isActiveUser() && resource.data.target_role == getProfileRole();
      allow create: if isActiveUser() && isNotReadOnly();
      allow update: if isActiveUser() && (
        (
          (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRead', 'readStatus', 'readAt', 'read'
          ])
        )
        || (
          (resource.data.recipientRole == getProfileRole()
            || resource.data.target_role == getProfileRole())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'readBy', 'readAtBy'
          ])
          && request.resource.data.readBy.toSet()
            .difference(resource.data.get('readBy', []).toSet())
            .hasOnly([request.auth.uid])
          && request.resource.data.readBy.toSet()
            .hasAll(resource.data.get('readBy', []).toSet())
          && request.resource.data.readAtBy
            .diff(resource.data.get('readAtBy', {}))
            .affectedKeys()
            .hasOnly([request.auth.uid])
        )
        || isAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // ── Admin / master data ──
    match /system_settings/{docId} {
      allow read: if isAuthenticated();
